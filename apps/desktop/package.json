{
  "name": "@virtual-shock/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Virtual Shock desktop host (Electron)",
  "author": "Virtual Shock",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare-mobile": "node scripts/prepare-mobile.mjs",
    "prepare-pack": "node scripts/prepare-pack.mjs",
    "download-vigem": "node scripts/download-vigem.mjs",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "pack:win": "node scripts/download-vigem.mjs && node scripts/prepare-pack.mjs && electron-builder --win --x64"
  },
  "dependencies": {
    "@virtual-shock/shared": "workspace:*",
    "koffi": "^2.10.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.1"
  },
  "optionalDependencies": {
    "vigemclient": "^1.5.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.0",
    "electron": "^35.0.1",
    "electron-builder": "^25.1.8",
    "node-addon-api": "1.7.2",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "com.virtualshock.controller",
    "productName": "Virtual Shock",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-mobile/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/vigem",
        "to": "vigem",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**/*",
      "**/node_modules/vigemclient/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VirtualShock-${version}-${arch}.${ext}"
    }
  }
}
